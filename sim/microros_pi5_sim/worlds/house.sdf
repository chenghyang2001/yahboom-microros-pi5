<?xml version="1.0"?>
<!-- 8 m × 6 m 的小屋：外牆在 x=±4、y=±3，中間兩道隔間牆（留門口），另有沙發、桌子、柱子、紅藍綠三個色塊（給視覺追蹤用）。
     車子出生在原點 (0,0)，面向 +x。 -->
<sdf version="1.9">
  <world name="house">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui><title>3D View</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">docked</property></gz-gui>
        <engine>ogre2</engine><scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light><background_color>0.8 0.85 0.9</background_color>
        <camera_pose>-5.5 -5.0 6.5 0 0.75 0.75</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"><gz-gui><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control"><gz-gui><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
      <plugin filename="CameraTracking" name="Camera Tracking"><gz-gui><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui><title>World control</title><property type="bool" key="showTitleBar">false</property><property type="bool" key="resizable">false</property><property type="double" key="height">72</property><property type="double" key="width">121</property><property type="double" key="z">1</property><property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors></gz-gui>
        <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
      </plugin>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.78 0.74 0.68 1</ambient><diffuse>0.78 0.74 0.68 1</diffuse></material></visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="link">
        <!-- 外牆 -->
        <collision name="n"><pose>0 3.05 0.3 0 0 0</pose><geometry><box><size>8.2 0.1 0.6</size></box></geometry></collision>
        <visual name="n_v"><pose>0 3.05 0.3 0 0 0</pose><geometry><box><size>8.2 0.1 0.6</size></box></geometry><material><ambient>0.92 0.92 0.9 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse></material></visual>
        <collision name="s"><pose>0 -3.05 0.3 0 0 0</pose><geometry><box><size>8.2 0.1 0.6</size></box></geometry></collision>
        <visual name="s_v"><pose>0 -3.05 0.3 0 0 0</pose><geometry><box><size>8.2 0.1 0.6</size></box></geometry><material><ambient>0.92 0.92 0.9 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse></material></visual>
        <collision name="e"><pose>4.05 0 0.3 0 0 0</pose><geometry><box><size>0.1 6.2 0.6</size></box></geometry></collision>
        <visual name="e_v"><pose>4.05 0 0.3 0 0 0</pose><geometry><box><size>0.1 6.2 0.6</size></box></geometry><material><ambient>0.92 0.92 0.9 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse></material></visual>
        <collision name="w"><pose>-4.05 0 0.3 0 0 0</pose><geometry><box><size>0.1 6.2 0.6</size></box></geometry></collision>
        <visual name="w_v"><pose>-4.05 0 0.3 0 0 0</pose><geometry><box><size>0.1 6.2 0.6</size></box></geometry><material><ambient>0.92 0.92 0.9 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse></material></visual>
        <!-- 隔間牆 1：x=1.5，從 y=-3 到 y=0.4（上方留 1 m 門口到 y=1.4，再接到北牆） -->
        <collision name="p1a"><pose>1.5 -1.3 0.3 0 0 0</pose><geometry><box><size>0.1 3.4 0.6</size></box></geometry></collision>
        <visual name="p1a_v"><pose>1.5 -1.3 0.3 0 0 0</pose><geometry><box><size>0.1 3.4 0.6</size></box></geometry><material><ambient>0.7 0.6 0.5 1</ambient><diffuse>0.7 0.6 0.5 1</diffuse></material></visual>
        <collision name="p1b"><pose>1.5 2.2 0.3 0 0 0</pose><geometry><box><size>0.1 1.6 0.6</size></box></geometry></collision>
        <visual name="p1b_v"><pose>1.5 2.2 0.3 0 0 0</pose><geometry><box><size>0.1 1.6 0.6</size></box></geometry><material><ambient>0.7 0.6 0.5 1</ambient><diffuse>0.7 0.6 0.5 1</diffuse></material></visual>
        <!-- 隔間牆 2：y=0.8，從 x=-4 到 x=-1.8（右側留門） -->
        <collision name="p2"><pose>-2.9 0.8 0.3 0 0 0</pose><geometry><box><size>2.2 0.1 0.6</size></box></geometry></collision>
        <visual name="p2_v"><pose>-2.9 0.8 0.3 0 0 0</pose><geometry><box><size>2.2 0.1 0.6</size></box></geometry><material><ambient>0.7 0.6 0.5 1</ambient><diffuse>0.7 0.6 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <model name="sofa">
      <static>true</static><pose>-2.6 -2.3 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.6 0.7 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 0.7 0.4</size></box></geometry><material><ambient>0.35 0.45 0.3 1</ambient><diffuse>0.35 0.45 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="table">
      <static>true</static><pose>2.8 -1.2 0.25 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 0.6 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 0.6 0.5</size></box></geometry><material><ambient>0.55 0.38 0.2 1</ambient><diffuse>0.55 0.38 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar">
      <static>true</static><pose>-0.8 1.9 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.6</length></cylinder></geometry><material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="red_block">
      <static>true</static><pose>1.2 -0.9 0.1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 0.2 0.2</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="blue_block">
      <static>true</static><pose>-1.0 -1.3 0.1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 0.2 0.2</size></box></geometry><material><ambient>0.1 0.3 0.9 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse></material></visual>
      </link>
    </model>
    <model name="green_block">
      <static>true</static><pose>3.2 2.0 0.1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.25 0.25 0.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.25 0.25 0.2</size></box></geometry><material><ambient>0.1 0.75 0.2 1</ambient><diffuse>0.1 0.75 0.2 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
